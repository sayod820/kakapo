#!/bin/sh
set -eu

unset NODE_OPTIONS NODE_PATH NPM_CONFIG_PREFIX npm_config_prefix

fail() {
  echo "KAKAPO SERVER READ WRAPPER ABORTED: $1" >&2
  exit 1
}

CURRENT_LIB='/usr/local/lib/kakapo-server-read-current'
[ -L "${CURRENT_LIB}" ] || fail 'current library link is missing or is not a symlink'
[ "$(/usr/bin/stat -c '%u:%g' -- "${CURRENT_LIB}")" = '0:0' ] \
  || fail 'current library link is not root-owned'

REAL_CLI=$(/usr/bin/readlink -f -- "${CURRENT_LIB}/cli.mjs") \
  || fail 'CLI symlink target is missing'
VERSION_DIR=${REAL_CLI%/cli.mjs}
VERSION_SHA=${VERSION_DIR#/usr/local/lib/kakapo-server-read-}
[ "${VERSION_SHA}" != "${VERSION_DIR}" ] \
  || fail 'CLI target is outside the versioned library root'
[ "${#VERSION_SHA}" -eq 40 ] \
  || fail 'CLI target version is not a full SHA'
case "${VERSION_SHA}" in
  *[!0-9a-f]*) fail 'CLI target version is not lowercase hexadecimal' ;;
esac
[ "${REAL_CLI}" = "/usr/local/lib/kakapo-server-read-${VERSION_SHA}/cli.mjs" ] \
  || fail 'CLI target is outside the expected versioned directory'
[ -f "${REAL_CLI}" ] && [ ! -L "${REAL_CLI}" ] \
  || fail 'resolved CLI target is not a regular file'
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "${REAL_CLI}")" = '0:0:644' ] \
  || fail 'resolved CLI ownership or mode is unsafe'
[ "$(/usr/bin/stat -c '%u:%g' -- "${VERSION_DIR}")" = '0:0' ] \
  || fail 'versioned library directory is not root-owned'
case "$(/usr/bin/stat -c '%a' -- "${VERSION_DIR}")" in
  700|701|704|705|710|711|714|715|740|741|744|745|750|751|754|755) ;;
  *) fail 'versioned library directory mode is unsafe' ;;
esac

exec /usr/bin/node "${REAL_CLI}" "$@"
