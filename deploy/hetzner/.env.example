# Ваш домен (без https://)
DOMAIN=kakappo.shop

# Публичные URL для сборки Next.js (обязательно https/wss после SSL)
PUBLIC_URL=https://kakappo.shop
WS_URL=wss://kakappo.shop
# Важно: NEXT_PUBLIC_API_URL в docker-compose для web оставляем пустым —
# браузер ходит на /api/kakapo (прокси). Не ставьте сюда PUBLIC_URL.

# CORS для API
CORS_ORIGINS=https://kakappo.shop,https://www.kakappo.shop

# PostgreSQL (обязательно в production)
POSTGRES_USER=kakapo
POSTGRES_PASSWORD=смените_пароль
POSTGRES_DB=kakapo
# Хост postgres — имя сервиса в docker-compose
DATABASE_URL=postgresql://kakapo:смените_пароль@postgres:5432/kakapo

# ИИ-ассистент админки (Google AI Studio → Create API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Email для Let's Encrypt (ssl-init.sh)
CERTBOT_EMAIL=admin@kakappo.shop

# Путь к репозиторию на сервере (setup-server.sh)
KAKAPO_REPO_DIR=/opt/kakapo
