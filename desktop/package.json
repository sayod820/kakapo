{
  "name": "kakapo-trade-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "КАКАПО Касса — одно приложение: чеки, этикетки, оборудование",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis",
    "build-ui": "npm run desktop:build-ui --prefix ..",
    "publish-out": "node ../scripts/publish-desktop-update.mjs"
  },
  "build": {
    "appId": "tj.kakapo.trade",
    "productName": "KAKAPO Kassa",
    "afterPack": "./afterPack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "casScale.cjs",
      "tsplLabel.cjs",
      "escposReceipt.cjs",
      "receiptTemplate.cjs",
      "localServer.cjs",
      "updater.cjs",
      "icon.png",
      "icon.ico",
      "config.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://kakappo.shop/updates/kassa"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "KAKAPO-Kassa-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KAKAPO Kassa"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3"
  }
}
